# Agent wallet private key used by smoke scripts (pnpm agent:me / agent:domain).
# AGENT_PRIVATE_KEY=0x...

# Billie service key — must own BILLIE_PARENT_NAME on Sepolia ENSv2.
# Also signs EIP-712 invoice attestations.
# BILLIE_PRIVATE_KEY=0x...

# Parent ENS name under which agent namespaces live (e.g. billie.eth).
# BILLIE_PARENT_NAME=billie.eth

# SQLite for linked domains + invoices.
# Unset/empty = in-memory (no files; lost on restart / serverless cold start).
# For local persistence: BILLIE_DB_PATH=data/billie.sqlite
# BILLIE_DB_PATH=

# Optional World Chain RPC for AgentBook lookups (defaults to public RPC).
# Prefer a reliable provider if public RPC returns false "not registered".
# WORLD_CHAIN_RPC_URL=

# Optional EVM RPC used during AgentKit signature verification.
# AGENTKIT_RPC_URL=

# Optional Ethereum Sepolia RPC for ENSv2 ownership checks (defaults to public RPC).
# ETHEREUM_SEPOLIA_RPC_URL=

# Shared PermissionedResolver for invoice ENS text records (pnpm ops:invoice-resolver).
# BILLIE_INVOICE_RESOLVER=0x...

# PaymentRouter for Billie Pay (pnpm ops:payment-router; requires forge).
# BILLIE_PAYMENT_ROUTER=0x...

# Etherscan API key — publish PaymentRouter source/ABI on Sepolia after deploy.
# Same key works for sepolia.etherscan.io (https://etherscan.io/apidashboard).
# ETHERSCAN_API_KEY=
# Then: pnpm ops:payment-router -- --verify-only

# Rate-limit Billie-paid namespace provisions per humanId (in-memory).
# Unset or 0 = disabled. Re-links do not consume a slot.
# BILLIE_DOMAIN_CLAIM_RATE_LIMIT=1
# BILLIE_DOMAIN_CLAIM_RATE_WINDOW_SEC=86400

# ENSv2 Sepolia addresses (defaults = current app.ens.dev deploy, ETHRegistry 0xdedb…).
# Newer 20260630 deploy exists (0x67b7… / factory 0x118B… / impl 0x840F…) — set these
# only if your name was registered on that deployment.
# ETHEREUM_SEPOLIA_ENS_V2_REGISTRY=0xdedb92913a25abe1f7bcdd85d8a344a43b398b67
# ETHEREUM_SEPOLIA_ENS_V2_FACTORY=0xD2a632D8a8b67c2c4398c255CbD7aF8dd7236198
# ETHEREUM_SEPOLIA_ENS_V2_USER_REGISTRY_IMPL=0x0F99e7Ea74903AfCB7224d0354fD7428A6f92917
# ETHEREUM_SEPOLIA_ENS_V2_PERMISSIONED_RESOLVER_IMPL=0xdcE5205A553573FFd47629327DDdf36186022FfA

# Smoke: also sign + POST /api/invoices/submit after prepare.
# BILLIE_SUBMIT_INVOICE=1

# Smoke: skip eth_estimateGas and use fixed EIP-1559 fees
# (needed when stub calldata would revert during estimation).
# Defaults ≈ $0.04 at $2000/ETH (200000 × 0.1 gwei).
# BILLIE_SKIP_GAS_ESTIMATE=1
# BILLIE_TX_GAS=200000
# BILLIE_TX_MAX_FEE_GWEI=0.1
# BILLIE_TX_PRIORITY_FEE_GWEI=0.05
