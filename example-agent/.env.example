# Agent wallet (AgentBook-registered). Never commit the real key.
AGENT_PRIVATE_KEY=0x...

# Billie HTTP API base URL (no trailing slash).
BILLIE_API_URL=http://127.0.0.1:3000

# Sepolia RPC — required to sign/submit invoice register txs.
ETHEREUM_SEPOLIA_RPC_URL=

# Optional AgentKit signer CAIP-2 (default eip155:8453).
# AGENT_CHAIN_ID=eip155:8453
